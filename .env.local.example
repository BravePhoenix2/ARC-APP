# App
NEXT_PUBLIC_APP_NAME=Artic
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — SQLite locally, zero setup. Swap to a Postgres connection
# string here (and the datasource provider in prisma/schema.prisma) later.
DATABASE_URL="file:./prisma/dev.db"

# Arc Testnet pilot (Mainnet is a separate release)
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_BLOCK_EXPLORER_URL=https://explorer.testnet.arc.io
NEXT_PUBLIC_ARC_USDC_SYMBOL=USDC
# ERC-20 USDC precision; native USDC gas uses 18 decimals in arcConfig.ts.
NEXT_PUBLIC_ARC_USDC_DECIMALS=6

# Wallet / app config
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_DEFAULT_CHAIN=arc

# Smart contract addresses (fill in after deployment — see scripts/deploy.js output)
NEXT_PUBLIC_FACTORY_CONTRACT_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ADDRESS=
NEXT_PUBLIC_ROYALTIES_CONTRACT_ADDRESS=

# Contract deployment (Hardhat reads these — server-side only, NEVER prefix
# with NEXT_PUBLIC_ or it would ship to the browser bundle)
# DEPLOYER_PRIVATE_KEY is the deployer wallet's private key, funded with
# network USDC for gas. For Testnet only, use Circle's Arc faucet.
DEPLOYER_PRIVATE_KEY=
FEE_RECIPIENT_ADDRESS=

# API / storage
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
NEXT_PUBLIC_INFURA_ID=
NEXT_PUBLIC_ALCHEMY_KEY=

# Optional feature flags
NEXT_PUBLIC_ENABLE_TESTNET=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Comma-separated wallets permitted to review creator applications.
# Leave empty to keep reviewer access disabled; never prefix this with NEXT_PUBLIC_.
ARTIQ_ADMIN_WALLETS=

# Optional pixel-based AI image screening (server-only; never NEXT_PUBLIC_).
# Enable only after configuring your own Sightengine account and credentials.
# Art submissions are sent to Sightengine when enabled; NFT submissions are not.
ARTIQ_AI_PIXEL_SCREENING=false
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Email sign-in codes (server-only). Use a Google app password, never your
# normal Gmail password. Store a separate random secret of at least 32 characters.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
ARTIQ_EMAIL_CODE_SECRET=
