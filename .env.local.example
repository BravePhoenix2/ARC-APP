
NEXT_PUBLIC_APP_NAME=Artic
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — SQLite locally, zero setup. Swap to a Postgres connection
# string here (and the datasource provider in prisma/schema.prisma) later.
DATABASE_URL="file:./prisma/dev.db"

# Arc Testnet pilot (Mainnet is a separate release)
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_BLOCK_EXPLORER_URL=https://explorer.testnet.arc.io
NEXT_PUBLIC_ARC_USDC_SYMBOL=USDC
# ERC-20 USDC precision; native USDC gas uses 18 decimals in arcConfig.ts.
NEXT_PUBLIC_ARC_USDC_DECIMALS=6

# Privy unified email + wallet sign-in (public IDs only).
# Create an app at https://dashboard.privy.io and enable Email + Ethereum wallet login.
# Optional: enable Authentication > Advanced > Return user data in an identity token.
# Without it, the server verifies linked accounts through Privy's authenticated API.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional app-client ID; leave empty unless configured in your Privy dashboard.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Legacy wallet / app config
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_DEFAULT_CHAIN=arc

# Smart contract addresses (fill in after deployment — see scripts/deploy.js output)
NEXT_PUBLIC_FACTORY_CONTRACT_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ADDRESS=
NEXT_PUBLIC_ROYALTIES_CONTRACT_ADDRESS=
# New NFT studio, original-art checkout, and funded rewards (Arc Testnet only).
# Deploy from /settings/protocol or scripts/deploy-studio.js, then rebuild.
NEXT_PUBLIC_STUDIO_FACTORY_ADDRESS=
NEXT_PUBLIC_ART_MARKET_ADDRESS=
NEXT_PUBLIC_AUCTION_HOUSE_ADDRESS=
# Previous houses remain selectable for existing auctions, refunds, and rewards.
NEXT_PUBLIC_LEGACY_AUCTION_HOUSE_ADDRESSES=
# Public treasury address prefilled in the browser deployment screen.
NEXT_PUBLIC_PLATFORM_FEE_RECIPIENT=

# Contract deployment (Hardhat reads these — server-side only, NEVER prefix
# with NEXT_PUBLIC_ or it would ship to the browser bundle)
# DEPLOYER_PRIVATE_KEY is the deployer wallet's private key, funded with
# network USDC for gas. For Testnet only, use Circle's Arc faucet.
DEPLOYER_PRIVATE_KEY=
FEE_RECIPIENT_ADDRESS=
# Deployment rates: standard creator mint fee 250 = 2.5%, buyer mint
# surcharge 200 = 2%, and marketplace/auction proceeds fee 250 = 2.5%.
# Alternative preset: creator mint fee 1000 = 10%, buyer surcharge 200 = 2%,
# and marketplace/auction proceeds fee 100 = 1%.
# Rates are immutable in each deployed contract (maximum 1000 = 10%).
MINT_FEE_BPS=250
MINT_SURCHARGE_BPS=200
MARKETPLACE_FEE_BPS=250

# API / storage
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
NEXT_PUBLIC_INFURA_ID=
NEXT_PUBLIC_ALCHEMY_KEY=

# Optional feature flags
NEXT_PUBLIC_ENABLE_TESTNET=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Comma-separated verified email addresses permitted to review creator applications.
# Leave empty to disable reviewer access. Server-only: never use NEXT_PUBLIC_.
# A contact email or wallet connection does not grant reviewer permissions.
ARTIQ_ADMIN_EMAILS=

# Optional pixel-based AI image screening (server-only; never NEXT_PUBLIC_).
# Enable only after configuring your own Sightengine account and credentials.
# Art submissions are sent to Sightengine when enabled; NFT submissions are not.
ARTIQ_AI_PIXEL_SCREENING=false
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Legacy email sign-in codes (server-only; retained for existing accounts/tests).
# Privy sends codes for the new Sign in flow; Gmail is not required by Privy.
# Use a Google app password, never your
# normal Gmail password. Store a separate random secret of at least 32 characters.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
ARTIQ_EMAIL_CODE_SECRET=

# Request protection. Trust forwarding headers only when the origin cannot be
# reached directly from the internet. The shared Cloudflare preview binds loopback.
# Allowed: cloudflare (CF-Connecting-IP), vercel (X-Vercel-Forwarded-For), or blank.
# Requests without a verified IP share one bounded quota and concurrency budget.
# Configure a restricted trusted ingress for separate client budgets in production.
ARTIQ_TRUSTED_PROXY=
# Optional Redis-compatible HTTPS REST service for shared atomic quotas/metrics.
# Without all three settings, limits and metrics apply to the current process.
ARTIQ_SECURITY_REDIS_URL=
ARTIQ_SECURITY_REDIS_TOKEN=
# Random server-only secret of at least 32 characters; identical on all instances.
ARTIQ_RATE_LIMIT_SECRET=
