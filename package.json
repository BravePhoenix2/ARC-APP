{
  "name": "artic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "compile": "npx hardhat compile",
    "studio:artifacts": "hardhat compile && node scripts/export-studio-artifacts.js",
    "studio:deploy:testnet": "hardhat run scripts/deploy-studio.js --network arcTestnet",
    "test:app": "node --import tsx --test test/auth/*.test.ts test/wallet/*.test.ts test/screening/*.test.ts test/preview/*.test.ts test/submissions/*.test.ts test/nft/*.test.ts test/leaderboard/*.test.ts",
    "tester:backfill": "node --import tsx scripts/backfill-testers.ts",
    "test": "hardhat test",
    "db:generate": "prisma generate",
    "db:setup": "prisma generate && npm run db:push && prisma db seed",
    "db:push": "node scripts/init-db.js && prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@privy-io/react-auth": "3.50.0",
    "@privy-io/wagmi": "4.0.19",
    "@stripe/stripe-js": "1.54.2",
    "@tanstack/react-query": "^5.101.4",
    "canvas-confetti": "^1.9.4",
    "ethers": "^6.17.0",
    "framer-motion": "^12.43.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.28.0",
    "next": "14.2.15",
    "nodemailer": "^10.1.7",
    "prisma": "^7.9.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.57.5",
    "wagmi": "^3.7.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "chai": "^4.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "hardhat": "^2.28.0",
    "postcss": "^8.4.49",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.11",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "@prisma/client@7.9.1": true,
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true
  }
}
