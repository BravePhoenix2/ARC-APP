{
  "name": "artic",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/sync-database-schemas.mjs && prisma generate",
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "node --import tsx scripts/check-vercel-config.ts && npm run db:generate && next build",
    "start": "next start",
    "build:local": "ARTIQ_LOCAL_BUILD=true next build",
    "start:local": "ARTIQ_LOCAL_BUILD=true ARTIQ_LOCAL_HTTP_ORIGIN=http://127.0.0.1:3000 next start --hostname 127.0.0.1 --port 3000",
    "preview": "npm run build:local && npm run start:local",
    "preview:share": "node scripts/serve-shared-preview.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "compile": "npx hardhat compile",
    "studio:artifacts": "hardhat compile && node scripts/export-studio-artifacts.cjs",
    "studio:pin-factories": "node --import tsx scripts/pin-collection-factories.ts",
    "studio:deploy:testnet": "hardhat run scripts/deploy-studio.js --network arcTestnet",
    "test:app": "node --import tsx --import ./test/setup.mjs --test test/auth/*.test.ts test/wallet/*.test.ts test/screening/*.test.ts test/preview/*.test.ts test/submissions/*.test.ts test/nft/*.test.ts test/leaderboard/*.test.ts test/security/*.test.ts test/database/*.test.ts",
    "tester:backfill": "node --import tsx scripts/backfill-testers.ts",
    "test": "hardhat test mocha test/*.js",
    "db:generate": "node scripts/sync-database-schemas.mjs && prisma generate",
    "db:setup": "prisma generate && npm run db:push && prisma db seed",
    "db:push": "node scripts/init-db.cjs && prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:schema:check": "node scripts/sync-database-schemas.mjs --check",
    "db:migrate": "node scripts/deploy-database.mjs",
    "db:import:sqlite": "node scripts/migrate-sqlite-to-postgres.mjs",
    "catalog:sync": "node --import tsx scripts/sync-catalog.ts",
    "data:maintain": "node --import tsx scripts/maintain-data.ts",
    "testnet:check": "node --import tsx scripts/check-testnet.ts",
    "release:verify": "npm run db:schema:check && npm run lint && npm run typecheck && npm run test:app && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@privy-io/react-auth": "3.51.2",
    "@privy-io/wagmi": "4.0.19",
    "@stripe/stripe-js": "1.54.2",
    "@tanstack/react-query": "^5.101.4",
    "canvas-confetti": "^1.9.4",
    "ethers": "^6.17.0",
    "framer-motion": "^12.43.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.28.0",
    "next": "15.5.28",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "viem": "2.57.5",
    "wagmi": "^3.7.11",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "chai": "^6.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "hardhat": "^3.21.1",
    "mocha": "^12.0.0",
    "postcss": "^8.5.32",
    "react-test-renderer": "19.3.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.11",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true,
    "@prisma/client@7.10.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "type": "module",
  "overrides": {
    "postcss": "$postcss",
    "@walletconnect/ethereum-provider": "2.22.4",
    "ws@>=8 <9": "$ws",
    "uuid@>=8 <10": "^11.1.1"
  }
}
