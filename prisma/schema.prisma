// Prisma schema for Artic. SQLite for zero-setup local dev — swap the
// datasource provider/url to Postgres later without touching the models.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ItemType {
  NFT
  WEB2_ART
}

// NFT lifecycle, per the mint/list flow described in the product proposal.
enum ItemStatus {
  UPCOMING
  LIVE
  MINTED_OUT
  LISTED
}

enum ArtCategory {
  PAINTING
  RUG
  COSMETIC
  OTHER
}

enum ActivityType {
  MINT
  SALE
  LISTING
  DELIST
  PRICE_UPDATE
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CreationMethod {
  UNKNOWN
  HUMAN
  AI_GENERATED
  AI_ASSISTED
}

model User {
  id            String   @id @default(cuid())
  walletAddress String?  @unique
  email         String?  @unique
  emailVerifiedAt DateTime?
  username      String?
  avatarUrl     String?
  bio           String?
  isCreator     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items      Item[]
  listings   Listing[]
  activities Activity[]
  submissions Submission[]
  emailSessions EmailSession[]
  uploadedImages UploadedImage[]
}

// One table for everything uploaded — itemType tells you which half of the
// (mostly-nullable) NFT/WEB2_ART fields is populated.
model Item {
  id          String   @id @default(cuid())
  itemType    ItemType
  title       String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creationMethod CreationMethod @default(UNKNOWN)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  // --- NFT fields ---
  contractAddress String?
  mintPriceUsdc   Float?
  mintStartTime   DateTime?
  maxSupply       Int?
  mintedCount     Int?        @default(0)
  rarities        Json?
  status          ItemStatus?

  // --- WEB2_ART fields ---
  category           ArtCategory?
  priceUsdc          Float?
  quantityAvailable  Int?
  sold               Boolean       @default(false)

  listings   Listing[]
  activities Activity[]
  submission Submission?

  @@index([itemType])
  @@index([status])
}

model Listing {
  id        String   @id @default(cuid())
  priceUsdc Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  @@index([itemId])
  @@index([active])
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  priceUsdc Float?
  createdAt DateTime     @default(now())

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([itemId])
  @@index([createdAt])
}

model Submission {
  id              String           @id @default(cuid())
  creatorId       String
  creator         User             @relation(fields: [creatorId], references: [id])
  creatorName     String
  contactEmail    String?
  itemType        ItemType
  title           String
  description     String
  imageUrl        String
  priceUsdc       Float
  category        ArtCategory?
  contractAddress String?
  maxSupply       Int?
  mintStartTime   DateTime?
  status          SubmissionStatus @default(PENDING)
  reviewNote      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  itemId          String?          @unique
  item            Item?            @relation(fields: [itemId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  creationMethod  CreationMethod   @default(UNKNOWN)
  humanMadeDeclaration Boolean    @default(false)
  creationProcess String?
  screening       Json?
  artReviewConfirmed Boolean      @default(false)

  @@index([creatorId, createdAt])
  @@index([status, createdAt])
}

model WalletChallenge {
  id            String   @id @default(cuid())
  walletAddress String
  nonce         String   @unique
  message       String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([walletAddress, expiresAt])
}

model WalletSession {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  walletAddress String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}

model UploadedImage {
  id          String   @id @default(cuid())
  ownerWallet String?
  ownerUserId String?
  owner       User?   @relation(fields: [ownerUserId], references: [id])
  mimeType    String
  data        Bytes
  createdAt   DateTime @default(now())
  screening   Json?

  @@index([ownerUserId, createdAt])
}

model EmailChallenge {
  id         String   @id @default(cuid())
  email      String
  origin     String
  codeHash   String
  attempts   Int      @default(0)
  delivered  Boolean  @default(false)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

model EmailSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
