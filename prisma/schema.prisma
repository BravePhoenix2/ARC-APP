// Canonical production models. Run db:generate to refresh the SQLite companion.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemType {
  NFT
  WEB2_ART
}

enum NftKind {
  COLLECTIBLE
  EDITION
  SOULBOUND
  MEMBERSHIP
}

// NFT lifecycle, per the mint/list flow described in the product proposal.
enum ItemStatus {
  UPCOMING
  LIVE
  MINTED_OUT
  LISTED
}

enum ArtCategory {
  PAINTING
  RUG
  COSMETIC
  OTHER
}

enum ActivityType {
  MINT
  SALE
  LISTING
  DELIST
  PRICE_UPDATE
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CreationMethod {
  UNKNOWN
  HUMAN
  AI_GENERATED
  AI_ASSISTED
}

model User {
  id            String   @id @default(cuid())
  privyId       String?  @unique
  walletAddress String?  @unique
  email         String?  @unique
  emailVerifiedAt DateTime?
  username      String?
  avatarUrl     String?
  bio           String?
  isCreator     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items      Item[]
  listings   Listing[]
  activities Activity[]
  submissions Submission[]
  emailSessions EmailSession[]
  privySessions PrivySession[]
  uploadedImages UploadedImage[]
  testerProfile TesterProfile?
  artOrders ArtOrder[]
  watchlist WatchlistEntry[]
  assetAuctions AssetAuction[]
}

// Public auction terms are committed on-chain. Downloads and delivery addresses
// are returned only through the authenticated fulfillment endpoint.
model AssetAuction {
  id                 String   @id @default(cuid())
  sellerId           String
  seller             User     @relation(fields: [sellerId], references: [id])
  sellerWallet       String
  kind               String
  title              String
  description        String
  imageUrl           String
  deliveryTerms      String
  reservePrice       String
  endsAt             DateTime
  assetKey           String   @unique
  marketAddress      String
  chainId            Int      @default(5042002)
  auctionId          String?
  activationTxHash   String?
  digitalDeliveryUrl String?
  delivery           Json?
  winnerWallet       String?
  fulfilledAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([chainId, marketAddress, auctionId])
  @@index([sellerId, createdAt])
  @@index([kind, createdAt, id])
  @@index([createdAt, id])
  @@index([imageUrl])
}

// Only verified sign-ins create tester profiles; seeded marketplace users do not count.
model TesterProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt     DateTime @default(now())
  lastActiveAt DateTime @default(now())
  milestones   TesterMilestone[]

  @@index([lastActiveAt])
}

model TesterMilestone {
  id        String        @id @default(cuid())
  profileId String
  profile   TesterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind      String
  chainId   Int?
  txHash    String?
  createdAt DateTime      @default(now())

  // Each task scores once. A verified transaction cannot be credited to two accounts.
  @@unique([profileId, kind])
  @@unique([chainId, txHash])
  @@index([kind])
}

// One table for everything uploaded — itemType tells you which half of the
// (mostly-nullable) NFT/WEB2_ART fields is populated.
model Item {
  id          String   @id @default(cuid())
  itemType    ItemType
  title       String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creationMethod CreationMethod @default(UNKNOWN)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  // --- NFT fields ---
  nftKind         NftKind?
  symbol          String?
  metadataUri     String?
  maxPerWallet    Int?
  royaltyBps      Int?
  attributes      Json?
  imageCount      Int @default(1)
  collectionImages CollectionImage[]
  contractAddress String?
  deploymentFactory String?
  mintAccessPlan MintAccessPlan?
  mintPriceUsdc   Float?
  mintStartTime   DateTime?
  maxSupply       Int?
  mintedCount     Int?        @default(0)
  rarities        Json?
  status          ItemStatus?

  // --- WEB2_ART fields ---
  category           ArtCategory?
  priceUsdc          Float?
  quantityAvailable  Int?
  sold               Boolean       @default(false)
  artListingId       String?
  artListingSeller   String?
  // Pin each listing to its original market when platform contracts are replaced.
  artMarketAddress   String?

  listings   Listing[]
  activities Activity[]
  submission Submission?
  artOrder ArtOrder?
  watchers WatchlistEntry[]

  @@index([createdAt, id])
  @@index([itemType, createdAt, id])
  @@index([creatorId, createdAt, id])
  @@index([itemType])
  @@index([nftKind])
  @@index([status])
}

model WatchlistEntry {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId, createdAt])
}

// Delivery details stay private to the buyer and the artwork's creator.
model ArtOrder {
  id            String   @id @default(cuid())
  itemId        String   @unique
  item          Item     @relation(fields: [itemId], references: [id])
  buyerId       String
  buyer         User     @relation(fields: [buyerId], references: [id])
  buyerWallet   String
  chainId       Int
  marketAddress String
  listingId     String
  txHash        String   @unique
  delivery      Json
  createdAt     DateTime @default(now())

  @@index([buyerId, createdAt])
}

model Listing {
  id        String   @id @default(cuid())
  priceUsdc Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  @@index([itemId])
  @@index([active])
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  priceUsdc Float?
  createdAt DateTime     @default(now())

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([itemId])
  @@index([createdAt])
}

model Submission {
  id              String           @id @default(cuid())
  creatorId       String
  creator         User             @relation(fields: [creatorId], references: [id])
  creatorName     String
  contactEmail    String?
  itemType        ItemType
  title           String
  description     String
  imageUrl        String
  priceUsdc       Float
  category        ArtCategory?
  nftKind         NftKind?
  symbol          String?
  metadataUri     String?
  maxPerWallet    Int?
  royaltyBps      Int?
  attributes      Json?
  imageCount      Int @default(1)
  collectionImages CollectionImage[]
  contractAddress String?
  maxSupply       Int?
  mintStartTime   DateTime?
  status          SubmissionStatus @default(PENDING)
  reviewNote      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  itemId          String?          @unique
  item            Item?            @relation(fields: [itemId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  creationMethod  CreationMethod   @default(UNKNOWN)
  humanMadeDeclaration Boolean    @default(false)
  creationProcess String?
  screening       Json?
  artReviewConfirmed Boolean      @default(false)

  @@index([creatorId, createdAt])
  @@index([status, createdAt])
}

model CollectionImage {
  id           String @id @default(cuid())
  position     Int
  filename     String
  imageUrl     String
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  itemId       String?
  item         Item? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([submissionId, position])
  @@unique([itemId, position])
  @@index([imageUrl])
}

model WalletChallenge {
  id            String   @id @default(cuid())
  walletAddress String
  nonce         String   @unique
  message       String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([walletAddress, expiresAt])
}

model WalletSession {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  walletAddress String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}

model UploadedImage {
  id          String   @id @default(cuid())
  ownerWallet String?
  ownerUserId String?
  owner       User?   @relation(fields: [ownerUserId], references: [id])
  mimeType    String
  data        Bytes
  // Private object storage; an empty data blob is used when this key is present.
  storageKey  String?
  byteSize    Int @default(0)
  createdAt   DateTime @default(now())
  screening   Json?

  @@index([ownerUserId, createdAt])
}

model EmailChallenge {
  id         String   @id @default(cuid())
  email      String
  origin     String
  codeHash   String
  attempts   Int      @default(0)
  delivered  Boolean  @default(false)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

model EmailSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Artic stores an opaque, revocable session, never a Privy access or identity token.
model PrivySession {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  privyDid        String
  verifiedEmail   String?
  walletAddresses Json
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

// Wallet rosters are private; public Item responses never include this relation.
model MintAccessPlan {
  id String @id @default(cuid())
  itemId String @unique
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  config Json
  root String?
  frozenAt DateTime?
  entries MintAllowlistEntry[]
}

model MintAllowlistEntry {
  id String @id @default(cuid())
  planId String
  plan MintAccessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  walletAddress String
  requestedTier String @default("FCFS")
  tier String @default("PENDING")
  createdAt DateTime @default(now())
  @@unique([planId, walletAddress])
}
