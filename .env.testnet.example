# Copy settings into the host's private environment; never commit credentials.
# Set up the permanent domain and Privy allowed origins before deploying collections.
NEXT_PUBLIC_APP_NAME=Artic
NEXT_PUBLIC_APP_URL=https://articmarket.xyz
ARTIQ_APP_ORIGIN=https://articmarket.xyz
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_BLOCK_EXPLORER_URL=https://explorer.testnet.arc.io
NEXT_PUBLIC_ENABLE_TESTNET=true
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
ARTIQ_ADMIN_EMAILS=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Supabase or another managed PostgreSQL provider. Runtime: pooled connection;
# schema deployment: direct/session connection. Use the provider's verified TLS config.
# Keep app tables outside unauthenticated Data API access; see deployment guide.
DATABASE_URL=
DIRECT_URL=
ARTIQ_DATABASE_POOL_SIZE=5

# Use a PRIVATE bucket; storage credentials must never use NEXT_PUBLIC_.
ARTIQ_UPLOAD_STORAGE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ARTIQ_SUPABASE_STORAGE_BUCKET=artiq-uploads

# Choose cloudflare or vercel only after restricting the origin to that ingress.
# For a Node host behind Cloudflare, block direct origin access.
ARTIQ_TRUSTED_PROXY=
# Configure all three for multiple app processes; one process can use local limits.
ARTIQ_SECURITY_REDIS_URL=
ARTIQ_SECURITY_REDIS_TOKEN=
ARTIQ_RATE_LIMIT_SECRET=

# Populate from verified current contract deployments. Retain previous auction houses.
NEXT_PUBLIC_STUDIO_FACTORY_ADDRESS=
NEXT_PUBLIC_ART_MARKET_ADDRESS=
NEXT_PUBLIC_AUCTION_HOUSE_ADDRESS=
NEXT_PUBLIC_LEGACY_AUCTION_HOUSE_ADDRESSES=
NEXT_PUBLIC_PLATFORM_FEE_RECIPIENT=
FEE_RECIPIENT_ADDRESS=
MINT_FEE_BPS=250
MINT_SURCHARGE_BPS=200
MARKETPLACE_FEE_BPS=250

# Optional pixel screening; enable only after verifying server credentials.
ARTIQ_AI_PIXEL_SCREENING=false
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
